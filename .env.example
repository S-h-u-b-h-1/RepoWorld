# RepoWorld v0.9.6 local server
APP_BASE_URL=http://127.0.0.1:8004
APP_ENV=development
# REPOWORLD_DB_PATH=./.data/repoworld.sqlite3

# Anonymous browser workspaces are automatic. No OAuth credentials needed.
# Workspaces are stored per browser cookie, not user accounts.

# Public GitHub API read requests; optional for higher rate budgets
GITHUB_TOKEN=

# Optional live AI developer explanations and tours
# Shared provider capacity can queue requests. This read timeout is 180 seconds by default; 30-240 supported.
BHARATCODE_TIMEOUT_SECONDS=180
BHARATCODE_API_KEY=

# Public demo limits (enforced automatically when APP_ENV=production)
REPOWORLD_AI_GLOBAL_DAILY=65
REPOWORLD_AI_GUEST_DAILY=10
REPOWORLD_AI_GUEST_10MIN=4
REPOWORLD_IMPORT_GLOBAL_HOURLY=20
REPOWORLD_IMPORT_GUEST_HOURLY=4
# Do not enable IP budgets behind a shared reverse proxy without trusted IP forwarding.
REPOWORLD_ENABLE_IP_BUDGET=0

# Optional GitHub sample-size override. Default: 6 without GITHUB_TOKEN, 16 with it.
# REPOWORLD_IMPORT_SOURCE_LIMIT=6

# Production only: require a real volume mount before reporting readiness.
# REPOWORLD_REQUIRE_MOUNTED_DB=1
# Render provides RENDER_EXTERNAL_URL; APP_BASE_URL overrides it for a custom domain.
